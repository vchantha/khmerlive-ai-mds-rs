POSTGRES_DB=khmerlive
POSTGRES_USER=khmerlive
POSTGRES_PASSWORD=change_this_long_password
DATABASE_URL=postgresql+psycopg://khmerlive:change_this_long_password@db:5432/khmerlive
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=khmerliveadmin
MINIO_ROOT_PASSWORD=change_this_long_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=khmerlive
MINIO_ACCESS_KEY=khmerliveadmin
MINIO_SECRET_KEY=change_this_long_minio_password
API_KEY=change_this_to_a_long_random_api_key
MODEL_MODE=demo
WHISPER_MODEL_PATH=/models/asr
TRANSLATION_MODEL_PATH=/models/mt
MAX_UPLOAD_MB=1024
MAX_VIDEO_DURATION_SECONDS=600

# Explicit comma-separated public hostnames allowed for URL capture. Empty disables URL ingestion.
STREAM_ALLOWED_HOSTS=

# Social OAuth sign-in (optional; leave IDs/secrets blank to disable buttons)
AUTH_SESSION_SECRET=change_this_auth_session_secret
AUTH_PUBLIC_BASE_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keep false until isolated egress firewall and SSRF defenses are deployed
STREAM_URL_ALLOW_USERS=false
# YouTube links (single public videos) are downloaded with yt-dlp; no STREAM_ALLOWED_HOSTS entry needed.
YOUTUBE_ENABLED=true

# Offline English-to-Khmer speech dubbing (research; MMS TTS weights are CC-BY-NC-4.0)
ENABLE_KHMER_DUBBING=true
KHMER_TTS_MODEL_PATH=/models/tts

# ---- Offline LLM post-editing (optional; needs compose.ollama.yaml, set by scripts/deploy.sh) ----
LLM_POSTEDIT_ENABLED=false
OLLAMA_MODEL=qwen3:4b-instruct

# ---- Performance (all optional; defaults are safe) ----
# Videos processed at the same time. CPU threads are split between them automatically.
# CPU-only: 1 per ~4 cores and ~4 GB RAM each. Small GPU (4 GB): keep 1.
WORKER_CONCURRENCY=1
# CPU threads per video (0 = auto: all cores / WORKER_CONCURRENCY)
CPU_THREADS=0
# Translation engine: auto = CTranslate2 when models/mt-ct2 exists (3-5x faster), else transformers
MT_ENGINE=auto
# GPU per stage (set by compose.gpu.yaml): ASR_DEVICE=cuda TTS_DEVICE=cuda MT_DEVICE=cpu
# On GPUs with 8 GB+ also use MT_DEVICE=cuda and ASR_RELEASE_AFTER_USE=false
